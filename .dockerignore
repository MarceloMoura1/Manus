!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!patches/
!patches/**
!.github/
!.github/qualification-provenance/
!.github/qualification-provenance/**
!third_party/
!third_party/e2e-chromium/
!third_party/e2e-chromium/**
!scripts/
!scripts/ops/
!scripts/ops/validate-sales-v5-e2e-tar.mjs
