# ============================================
# MegaDesk - Variáveis de Ambiente
# Copie este arquivo como .env na raiz do projeto
# ============================================

# Ambiente
NODE_ENV=production

# Banco de dados MySQL (ajuste a senha)
DATABASE_URL=mysql://megadesk:SuaSenhaAqui@127.0.0.1:3306/megadesk_main

# JWT (use uma chave forte e aleatória)
JWT_SECRET=megadesk-jwt-secret-troque-por-algo-seguro-2024

# App ID
VITE_APP_ID=megadesk-prod

# Domínios oficiais
APP_URL=https://app.megadesk.online
ADMIN_URL=https://admin.megadesk.online
API_URL=https://api.megadesk.online
COOKIE_DOMAIN=.megadesk.online

# Evolution API (WhatsApp via QR Code)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=megadesk-evolution-key-2024
WEBHOOK_BASE_URL=https://api.megadesk.online

# Google Gemini (IA) - opcional
GEMINI_API_KEY=

# Meta WhatsApp API Oficial - opcional
META_WEBHOOK_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
