# =============================================================================
# MegaDesk Platform — Variáveis de Ambiente (.env)
# =============================================================================
# COMO USAR:
#   1. Copie este arquivo: cp .env.example .env
#   2. Preencha as credenciais e URLs reais no .env gerado
#   3. NUNCA versione ou envie o arquivo .env para o repositório Git!
# =============================================================================

# ── 1. AMBIENTE E REDE ─────────────────────────────────────────────────────────
NODE_ENV=development
# Valores permitidos: development | production | test
HOST=0.0.0.0
PORT=3000
# Quantidade de proxies reversos confiáveis (Cloudflare/Nginx na VPS geralmente = 1)
TRUST_PROXY_HOPS=1

# ── 2. BANCO DE DADOS (MySQL 8.0+) ─────────────────────────────────────────────
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=mysql://megadesk:SUA_SENHA_AQUI@127.0.0.1:3306/megadesk_main
# Modo de persistência principal: mysql (padrão)
MEGADESK_STORAGE_MODE=mysql

# ── 3. AUTENTICAÇÃO E SEGURANÇA ───────────────────────────────────────────────
# Chave secreta longa para assinar tokens JWT de sessão
# OBRIGATÓRIO: gere uma string aleatória forte (ex: openssl rand -base64 64)
JWT_SECRET=
# Tempo de vida da sessão em horas (padrão: 168 = 7 dias)
MEGADESK_SESSION_TTL_HOURS=168
# Origens CORS permitidas (separadas por vírgula em produção, ou vazio para padrão)
MEGADESK_ALLOWED_ORIGINS=

# ── 4. DOMÍNIOS E URLS (PRODUÇÃO & TUNNELS) ───────────────────────────────────
# Em desenvolvimento local:
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000/admin
API_URL=http://localhost:3000
COOKIE_DOMAIN=localhost
WEBHOOK_BASE_URL=http://localhost:3000

# Em produção na VPS (exemplo com Cloudflare / domínios reais):
# APP_URL=https://app.megadesk.online
# ADMIN_URL=https://admin.megadesk.online
# API_URL=https://api.megadesk.online
# COOKIE_DOMAIN=.megadesk.online
# WEBHOOK_BASE_URL=https://api.megadesk.online

# ── 5. MOTOR DE IA (GOOGLE GEMINI / HERMES) ───────────────────────────────────
# Chave da API do Google Gemini (Google AI Studio)
GEMINI_API_KEY=
# Modelo utilizado pelo Hermes (padrão recomendado: gemini-1.5-flash ou gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# ── 6. EVOLUTION API (WHATSAPP QR CODE) ───────────────────────────────────────
# URL interna ou externa da Evolution API (porta padrão: 8080)
EVOLUTION_API_URL=http://localhost:8080
# Chave global da Evolution API (definida no docker-compose.evolution.yml)
EVOLUTION_API_KEY=
# Segredo para autenticar webhooks enviados pela Evolution API ao MegaDesk
EVOLUTION_WEBHOOK_SECRET=
# Banco MySQL da Evolution API (Docker)
EVOLUTION_MYSQL_ROOT_PASSWORD=
EVOLUTION_MYSQL_DATABASE=evolution_api
EVOLUTION_MYSQL_USER=evolution
EVOLUTION_MYSQL_PASSWORD=

# ── 7. ARMAZENAMENTO DE ARQUIVOS E MÍDIA ──────────────────────────────────────
# Diretório local de armazenamento de mídias/anexos (opcional, padrão usa pasta do sistema)
MEGADESK_MEDIA_ROOT=
# Se utilizar AWS S3 para armazenamento de mídias (opcional):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

# ── 8. META WHATSAPP BUSINESS CLOUD API (OPCIONAL) ────────────────────────────
# Apenas caso integre com WhatsApp Cloud API oficial da Meta
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=

# ── 9. INTEGRAÇÕES COMPATÍVEIS (OPCIONAL / LEGADO) ───────────────────────────
VITE_APP_ID=megadesk-prod
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
