# =============================================================================
# MegaDesk Platform — Variáveis de Ambiente
# =============================================================================
# COMO USAR:
#   cp .env.example .env
#   Edite o arquivo .env com seus valores reais
#   NUNCA commite o arquivo .env no git
# =============================================================================

# ── AMBIENTE ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# Valores possíveis: development | production

# ── BANCO DE DADOS (MySQL 8.0+) ───────────────────────────────────────────────
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=mysql://megadesk:TROQUE_AQUI@127.0.0.1:3306/megadesk_main

# ── AUTENTICAÇÃO JWT ──────────────────────────────────────────────────────────
# Use uma string longa e aleatória. Gere com: openssl rand -base64 64
# OBRIGATÓRIO — o servidor não inicia sem este valor
JWT_SECRET=

# ── PORTA DO SERVIDOR ─────────────────────────────────────────────────────────
PORT=3000

# ── APP ID (Manus OAuth) ──────────────────────────────────────────────────────
# Usado apenas se integrar com Manus OAuth (opcional no modo local)
VITE_APP_ID=megadesk-prod
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# ── EVOLUTION API (WhatsApp via QR Code) ─────────────────────────────────────
# URL da sua instância Evolution API
EVOLUTION_API_URL=http://localhost:8080
# Obrigatórias. Gere valores fortes e diferentes; nunca versione os valores reais.
EVOLUTION_API_KEY=
EVOLUTION_MYSQL_ROOT_PASSWORD=
EVOLUTION_MYSQL_DATABASE=evolution_api
EVOLUTION_MYSQL_USER=evolution
EVOLUTION_MYSQL_PASSWORD=
# URL base para webhooks — deve ser acessível pela Evolution API
WEBHOOK_BASE_URL=https://api.megadesk.online

# ── DOMÍNIOS OFICIAIS (Produção via Cloudflare Tunnel) ───────────────────────
APP_URL=https://app.megadesk.online
ADMIN_URL=https://admin.megadesk.online
API_URL=https://api.megadesk.online
COOKIE_DOMAIN=.megadesk.online
# Em desenvolvimento local, deixe as linhas acima e defina:
# APP_URL=http://localhost:3000
# ADMIN_URL=http://localhost:3000/admin
# API_URL=http://localhost:3000
# COOKIE_DOMAIN=localhost

# ── GEMINI IA (Google) ────────────────────────────────────────────────────────
# Opcional — necessário apenas para assistente IA
GEMINI_API_KEY=

# ── META WHATSAPP BUSINESS API (Opcional) ─────────────────────────────────────
# Apenas para WhatsApp Business API oficial (pago)
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=

# ── AWS S3 (Armazenamento de arquivos — Opcional) ─────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

# ── FORGE API (Manus) ─────────────────────────────────────────────────────────
# Usado apenas no ambiente Manus — deixar vazio no ambiente próprio
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
